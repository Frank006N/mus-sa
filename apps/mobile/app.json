{
  "expo": {
    "name": "MUT Social",
    "slug": "mut-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#064e3b"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "extra": {
      "eas": {
        "projectId": "d046af67-7a9c-478b-b8e4-d5d96572a820"
      }
    },
    "android": {
      "package": "com.mutsocial.pitch",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064e3b"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store"
    ]
  }
}
